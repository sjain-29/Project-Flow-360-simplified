{
  "rules": {
    ".read": false,
    ".write": false,
    "system": {
      ".read": "auth != null",
      "bootstrapUid": {
        ".write": false
      },
      "initialized": {
        ".write": "(auth != null && root.child('system/bootstrapUid').val() === auth.uid && !root.child('system/initialized').exists()) && newData.val() === true"
      }
    },
    "loginIndex": {
      "$username": {
        ".read": true,
        ".write": "((auth != null && root.child('users/' + auth.uid).child('active').val() === true) && root.child('users/' + auth.uid).child('role').val() === 'admin') || ((auth != null && root.child('system/bootstrapUid').val() === auth.uid && !root.child('system/initialized').exists()) && auth.token.email === $username + '@pf360.example.com')",
        ".validate": "newData.hasChildren(['v']) && newData.child('v').isNumber() && newData.child('v').val() >= 1",
        "v": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "users": {
      ".read": "((auth != null && root.child('users/' + auth.uid).child('active').val() === true) && root.child('users/' + auth.uid).child('role').val() === 'admin')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "(((auth != null && root.child('users/' + auth.uid).child('active').val() === true) && root.child('users/' + auth.uid).child('role').val() === 'admin') && ($uid !== auth.uid || (newData.child('role').val() === 'admin' && newData.child('active').val() === true))) || ((auth != null && root.child('system/bootstrapUid').val() === auth.uid && !root.child('system/initialized').exists()) && $uid === auth.uid)",
        ".validate": "newData.hasChildren(['username', 'name', 'role', 'active']) && (newData.child('role').val() === 'commenter' || newData.child('role').val() === 'viewer' || ($uid === auth.uid && newData.child('role').val() === 'admin'))",
        "username": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z][a-z0-9_-]{1,31}$/)"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
        },
        "role": {
          ".validate": "(newData.val() === 'admin' || newData.val() === 'commenter' || newData.val() === 'viewer')"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "mustChangePassword": {
          ".write": "auth != null && auth.uid === $uid && data.exists() && newData.val() === false",
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "replacedBy": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "settings": {
      ".read": "(auth != null && root.child('users/' + auth.uid).child('active').val() === true)",
      ".write": "((auth != null && root.child('users/' + auth.uid).child('active').val() === true) && root.child('users/' + auth.uid).child('role').val() === 'admin') || (auth != null && root.child('system/bootstrapUid').val() === auth.uid && !root.child('system/initialized').exists())",
      "orgName": {
        ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
      },
      "dueSoonDays": {
        ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 60"
      },
      "stageTemplate": {
        "$k": {
          ".validate": "newData.hasChildren(['name', 'order'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
          },
          "owner": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 120"
          },
          "order": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "projects": {
      ".read": "(auth != null && root.child('users/' + auth.uid).child('active').val() === true)",
      ".write": "((auth != null && root.child('users/' + auth.uid).child('active').val() === true) && root.child('users/' + auth.uid).child('role').val() === 'admin')",
      "$pid": {
        ".validate": "$pid.matches(/^[A-Z0-9][A-Z0-9-]{1,23}$/) && newData.hasChildren(['code', 'name', 'status']) && newData.child('code').val() === $pid",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 160"
        },
        "status": {
          ".validate": "(newData.val() === 'Planning' || newData.val() === 'Active' || newData.val() === 'On Hold' || newData.val() === 'Completed' || newData.val() === 'Cancelled')"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 5000"
        },
        "priority": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },
        "startDate": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "targetDate": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedBy": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "items": {
      ".read": "(auth != null && root.child('users/' + auth.uid).child('active').val() === true)",
      ".write": "((auth != null && root.child('users/' + auth.uid).child('active').val() === true) && root.child('users/' + auth.uid).child('role').val() === 'admin')",
      "$pid": {
        "$iid": {
          ".validate": "newData.hasChildren(['code', 'name']) && newData.parent().parent().parent().child('projects').child($pid).exists()",
          "code": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 160"
          },
          "qty": {
            ".validate": "newData.isNumber()"
          },
          "unit": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 20"
          },
          "priority": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "requiredBy": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "notes": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 5000"
          },
          "order": {
            ".validate": "newData.isNumber()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "updatedBy": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "stages": {
      ".read": "(auth != null && root.child('users/' + auth.uid).child('active').val() === true)",
      ".write": "((auth != null && root.child('users/' + auth.uid).child('active').val() === true) && root.child('users/' + auth.uid).child('role').val() === 'admin')",
      "$pid": {
        "$iid": {
          "$sid": {
            ".validate": "newData.hasChildren(['name', 'order', 'status']) && newData.parent().parent().parent().parent().child('items').child($pid).child($iid).exists()",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
            },
            "owner": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 120"
            },
            "order": {
              ".validate": "newData.isNumber()"
            },
            "status": {
              ".validate": "(newData.val() === 'Not Started' || newData.val() === 'In Progress' || newData.val() === 'Waiting' || newData.val() === 'On Hold' || newData.val() === 'Completed' || newData.val() === 'Not Applicable')"
            },
            "expStart": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "expEnd": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "actStart": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "doneOn": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "ref": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 120"
            },
            "notes": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 5000"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "updatedBy": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "comments": {
      ".read": "(auth != null && root.child('users/' + auth.uid).child('active').val() === true)",
      "$pid": {
        ".write": "((auth != null && root.child('users/' + auth.uid).child('active').val() === true) && root.child('users/' + auth.uid).child('role').val() === 'admin')",
        "$cid": {
          ".write": "(((auth != null && root.child('users/' + auth.uid).child('active').val() === true) && (root.child('users/' + auth.uid).child('role').val() === 'admin' || root.child('users/' + auth.uid).child('role').val() === 'commenter')) && !data.exists() && newData.child('by').val() === auth.uid && newData.child('byName').val() === root.child('users/' + auth.uid).child('name').val()) || ((auth != null && root.child('users/' + auth.uid).child('active').val() === true) && data.child('by').val() === auth.uid && !newData.exists())",
          ".validate": "newData.hasChildren(['text', 'by', 'byName', 'at']) && newData.parent().parent().parent().child('projects').child($pid).exists()",
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
          },
          "byName": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now + 300000"
          },
          "itemId": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 128"
          },
          "stageId": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 128"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "activity": {
      ".read": "(auth != null && root.child('users/' + auth.uid).child('active').val() === true)",
      ".write": "((auth != null && root.child('users/' + auth.uid).child('active').val() === true) && root.child('users/' + auth.uid).child('role').val() === 'admin')",
      "$pid": {
        "$aid": {
          ".validate": "newData.hasChildren(['at', 'by', 'text'])"
        }
      }
    }
  }
}
